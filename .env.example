# =============================================================================
# CL-LoRA Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your local paths
# These paths are loaded by python-dotenv and used in config files

# =============================================================================
# Data Paths
# =============================================================================
# BigEarthNet-V2 dataset locations
PATHS_IMAGES_LMDB=/path/to/BigEarthNet-V2/BigEarthNet-V2-LMDB
PATHS_METADATA=/path/to/BigEarthNet-V2/metadata.parquet
PATHS_METADATA_SNOW_CLOUD=/path/to/BigEarthNet-V2/metadata_for_patches_with_snow_cloud_or_shadow.parquet

# =============================================================================
# Pretrained Model Paths
# =============================================================================
# SpectralGPT pretrained weights
PATHS_SPECTRAL_PRETRAINED=/path/to/SpectralGPT/SpectralGPT.pth
PATHS_SPECTRAL_PLUS_PRETRAINED=/path/to/SpectralGPT/S+/SpectralGPT+.pth

# SoftCon pretrained weights
PATHS_SOFTCON_PRETRAINED=/path/to/softcon/pretrained/B13_vitb14_softcon.pth

# =============================================================================
# Output Paths
# =============================================================================
# Directory for saving trained models and checkpoints
PATHS_SAVE_DIR=./saved_models

# Directory for logs
PATHS_LOG_DIR=./logs
