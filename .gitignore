# =============================================================================
# CL-LoRA .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.code-workspace

# Jupyter
.ipynb_checkpoints/

# Logs and outputs (logs/baseline and logs/merge hold the reported runs and are tracked)
*.log
*.err
*.out
log/
logs/runs/
!logs/baseline/**
!logs/merge/**

# Model checkpoints and saved models
saved_models/
*.pt
*.pth
*.ckpt
*.safetensors
!*.safetensors.example

# Data (large files)
*.lmdb
*.parquet

# Archive
archive/

# OS
.DS_Store
Thumbs.db

# Project specific
softcon/
demos/

# UV / pip
.uv/
uv.lock
